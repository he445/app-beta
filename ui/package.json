{
  "name": "qa-digitalizacao-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interface web do QA automático de digitalização (fala com o motor só pela API do contrato).",
  "scripts": {
    "gen": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e:celular": "node e2e/celular.cjs",
    "e2e": "node e2e/fluxo-completo.cjs",
    "e2e:desktop": "node e2e/desktop.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.0",
    "openseadragon": "4.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/openseadragon": "3.0.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "openapi-typescript": "7.4.1",
    "playwright": "1.63.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
