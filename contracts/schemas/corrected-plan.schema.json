{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrected-plan.schema.json",
  "title": "CorrectedPlan",
  "description": "Como o lote corrigido vai ficar com as decisões atuais (faixa \"Depois\").",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "can_save",
    "blockers",
    "pending_critical",
    "pending_rescan",
    "unsaved_operations",
    "documents"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "can_save": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "document_id",
          "document",
          "message"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "document": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "pending_critical": {
      "type": "integer",
      "minimum": 0
    },
    "pending_rescan": {
      "type": "integer",
      "minimum": 0
    },
    "unsaved_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "corrected-document.schema.json"
      }
    }
  }
}
