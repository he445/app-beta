{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "batch_id",
    "name",
    "page_ids",
    "state",
    "proposed_order"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "page_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "state": {
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "proposed_order": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Vazio quando não há reordenação proposta."
    },
    "manual_order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_ids",
        "reviewer",
        "decided_at"
      ],
      "description": "Ordem escolhida pelo revisor na tela de Sequência; vale sobre proposed_order no lote corrigido. Ausente quando o revisor não reordenou.",
      "properties": {
        "page_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
