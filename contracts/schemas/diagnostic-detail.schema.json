{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic-detail.schema.json",
  "title": "DiagnosticDetail",
  "description": "Um grupo de erros com a pilha e a linha do tempo das ocorrências (as 200 mais recentes).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group",
    "occurrences"
  ],
  "properties": {
    "group": {
      "$ref": "diagnostic-group.schema.json"
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "signature",
          "at",
          "version",
          "machine",
          "os",
          "severity",
          "origin",
          "kind",
          "location",
          "message",
          "stack"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "machine": {
            "type": [
              "string",
              "null"
            ]
          },
          "os": {
            "type": [
              "string",
              "null"
            ]
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "stack": {
            "type": [
              "string",
              "null"
            ]
          },
          "where": {
            "type": [
              "string",
              "null"
            ]
          },
          "batch_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
