{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrected-batch.schema.json",
  "title": "CorrectedBatch",
  "description": "Resultado de \"Salvar correções\".",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file",
    "download",
    "size_bytes",
    "sha256",
    "generated_at",
    "totals",
    "pending_critical",
    "saved_operations"
  ],
  "properties": {
    "file": {
      "type": "string",
      "description": "Nome do arquivo .zip ou da pasta gerada."
    },
    "download": {
      "type": [
        "string",
        "null"
      ],
      "description": "Rota para baixar o .zip; vazio quando o destino é pasta."
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Tamanho do .zip, ou a soma dos arquivos da pasta."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 do .zip, ou do manifest.json quando o destino é pasta."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exported",
        "removed",
        "not_exported",
        "corrected",
        "moved",
        "missing_pages"
      ],
      "properties": {
        "exported": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "not_exported": {
          "type": "integer",
          "minimum": 0
        },
        "corrected": {
          "type": "integer",
          "minimum": 0
        },
        "moved": {
          "type": "integer",
          "minimum": 0
        },
        "missing_pages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pending_critical": {
      "type": "integer",
      "minimum": 0
    },
    "saved_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "destination": {
      "enum": [
        "zip",
        "folder"
      ]
    },
    "folder": {
      "type": [
        "string",
        "null"
      ],
      "description": "Caminho da pasta gerada, quando o destino é pasta."
    }
  }
}
