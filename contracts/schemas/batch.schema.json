{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch.schema.json",
  "title": "Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "profile_id",
    "analyzed_at",
    "engine_version",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "summary": {
      "$ref": "batch-summary.schema.json"
    }
  }
}
