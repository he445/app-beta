{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metadata-field.schema.json",
  "title": "MetadataField",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "value",
    "source",
    "confidence",
    "required_by_decree",
    "confirmed"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "value": {},
    "source": {
      "enum": [
        "file_tag",
        "file_mtime",
        "profile",
        "generated",
        "computed",
        "ocr",
        "reviewer",
        "unavailable"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_by_decree": {
      "type": "boolean"
    },
    "confirmed": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  }
}
