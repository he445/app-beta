{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch-status.schema.json",
  "title": "BatchStatus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status",
    "progress",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "processing",
        "analyzed",
        "failed"
      ]
    },
    "progress": {
      "type": "object",
      "required": [
        "done",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "summary": {
      "$ref": "batch-summary.schema.json"
    },
    "source": {
      "enum": [
        "upload",
        "demo",
        "local"
      ],
      "description": "Como o lote entrou: enviado pelo navegador, lote de demonstração do servidor ou pasta lida no lugar."
    },
    "stage": {
      "enum": [
        "settling",
        "snapshot",
        "analyzing",
        null
      ],
      "description": "Etapa enquanto o lote está na fila ou em análise: esperando a pasta parar de mudar, tirando o retrato dos arquivos ou analisando."
    }
  }
}
