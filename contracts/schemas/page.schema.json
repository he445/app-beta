{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "page.schema.json",
  "title": "Page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "document_id",
    "index",
    "source_file",
    "page_in_file",
    "width_px",
    "height_px",
    "dpi",
    "color_mode",
    "sha256",
    "loaded",
    "station"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "source_file": {
      "type": "string",
      "description": "Arquivo da página, relativo à pasta do lote. Folha inserida depois (área de complementos do lote, nunca a pasta original) começa com \":complemento:/\"."
    },
    "page_in_file": {
      "type": "integer",
      "minimum": 0
    },
    "width_px": {
      "type": "integer",
      "minimum": 0
    },
    "height_px": {
      "type": "integer",
      "minimum": 0
    },
    "dpi": {
      "type": [
        "number",
        "null"
      ]
    },
    "color_mode": {
      "enum": [
        "bilevel",
        "gray",
        "rgb",
        null
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "loaded": {
      "type": "boolean"
    },
    "station": {
      "type": [
        "string",
        "null"
      ]
    },
    "numbering": {
      "$ref": "numbering.schema.json"
    },
    "station_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identificador da estação no perfil, quando a página foi ligada a uma (pelo arquivo ou pela estação padrão). Define os ajustes de regra aplicados à página."
    }
  }
}
