{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "numbering.schema.json",
  "title": "PageNumbering",
  "type": "object",
  "required": [
    "state",
    "value",
    "confidence",
    "previous"
  ],
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "read",
        "inferred",
        "renumbered",
        "ambiguous",
        "illegible",
        "absent"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "description": "Folha vigente na forma canônica: 12, 12-A, 12v."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "previous": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Números riscados (numeração anterior)."
    }
  }
}
