{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "numbering.schema.json",
  "title": "PageNumbering",
  "type": "object",
  "required": [
    "state",
    "value",
    "confidence",
    "previous"
  ],
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "read",
        "inferred",
        "renumbered",
        "ambiguous",
        "illegible",
        "absent"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "description": "Folha vigente na forma canônica: 12, 12-A, 12v."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "previous": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Números riscados (numeração anterior)."
    },
    "source": {
      "enum": [
        "image",
        "sidecar"
      ],
      "description": "De onde vieram as marcas: lidas da imagem ou do numbering.json do lote."
    },
    "marks": {
      "type": "array",
      "description": "Marcas encontradas na página como foram lidas (até três leituras cada e se está riscada). A numeração digitada não entra aqui.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "readings",
          "struck"
        ],
        "properties": {
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "confidence"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "struck": {
            "type": "boolean"
          }
        }
      }
    },
    "typed": {
      "type": "string",
      "description": "Numeração digitada pelo revisor na tela de Sequência; vale sobre as marcas na resolução."
    }
  }
}
